# 在此处填入你的 DeepSeek API Key；不要把真实 .env 提交到 Git。
DEEPSEEK_API_KEY=your_api_key_here

# 可选：默认模型
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# local：计划保存在本机 SQLite；demo：公开样例按浏览器会话保存
APP_MODE=local

# 公开真实生成可选；未配置时仅开放无需 API 的样例
# DEMO_INVITE_CODE=请设置一个不可猜的邀请码
# DEMO_DATABASE_URL=postgresql://...
# DEMO_DAILY_LIMIT=3
